# 生产环境前端配置（子路径挂载 /zhike/，经平台反向代理对外提供 HTTPS）

# Vite base：决定静态资源、入口脚本的 URL 前缀（vite.config.ts 通过 loadEnv 读取）
VITE_BASE_PATH=/zhike/

# 后端 API 根路径：反代会把 /zhike/api/ 剥成 /api/ 转发到 backend:8001
VITE_API_BASE_URL=/zhike/api/v1

# WebSocket 留空，由 src/api/ws.ts 依据 BASE_URL 自动推导为 wss://<host>/zhike/ws
VITE_WS_BASE_URL=

# 使用真实后端（非 mock）
VITE_USE_MOCKS=false

# 若最终改用其它前缀（如 /workspace/），只需把上面两处 /zhike 整体替换后重新构建
