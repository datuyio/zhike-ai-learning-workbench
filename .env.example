APP_NAME=zhike-workshop
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zhike_workshop
POSTGRES_USER=zhike
POSTGRES_PASSWORD=zhike_password
DATABASE_URL=postgresql+psycopg://zhike:zhike_password@localhost:5432/zhike_workshop

VALKEY_URL=redis://localhost:6379/0
OBJECT_STORAGE_ROOT=./storage

JWT_SECRET_KEY=replace-with-random-64-char-secret
ENCRYPTION_KEY=replace-with-random-64-char-encryption-key
SEED_ADMIN_EMAIL=admin@example.edu.cn
SEED_ADMIN_PASSWORD=
# 仅本地开发/比赛演示可启用：账号存在且 active 时跳过密码校验，生产或预发布环境会拒绝启动。
DEV_AUTH_SKIP_PASSWORD_CHECK=false

DEFAULT_COURSE_ID=deep_learning_001
DEFAULT_MODEL_PROVIDER=deepseek
DEFAULT_CHAT_MODEL=deepseek-chat
DEFAULT_EMBEDDING_MODEL=bge-m3

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 前端 WebSocket 显式地址；留空时会从 VITE_API_BASE_URL 或 window.location 推导。
VITE_WS_BASE_URL=ws://localhost:8001/ws

# 模型网关运行参数
MODEL_GATEWAY_BASE_URL=https://api.deepseek.com
MODEL_GATEWAY_TIMEOUT_SECONDS=60
MODEL_GATEWAY_MAX_TOKENS=1200
MODEL_GATEWAY_TEMPERATURE=0.2
MODEL_GATEWAY_CACHE_TTL_SECONDS=30
MODEL_GATEWAY_FAILURE_THRESHOLD=3
MODEL_GATEWAY_HEALTH_CHECK_INTERVAL_SECONDS=600
MODEL_GATEWAY_HEALTH_COOLDOWN_SECONDS=300


# 模型供应商 API Key。至少配置一个可用供应商；未配置时 AI 自习室仅能使用本地降级回答。
MODEL_GATEWAY_API_KEY=
DEEPSEEK_API_KEY=
IFLYTEK_SPARK_API_KEY=
DASHSCOPE_API_KEY=
QWEN_API_KEY=
ZHIPU_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=
DOUBAO_API_KEY=
HUNYUAN_API_KEY=
SILICONFLOW_API_KEY=
IMAGE_GENERATION_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
FAL_API_KEY=

# 知识库上传（与前端 /admin/knowledge/upload-policy 对齐）
MAX_DOCUMENT_UPLOAD_BYTES=52428800
BLOCK_DUPLICATE_DOCUMENT_UPLOAD=true
BLOCK_DUPLICATE_FILENAME=true

# RAG：PDF / TXT / MD 均由讯飞 ChatDoc 云端入库与检索（https://chatdoc.xfyun.cn/docs#/）
# 凭证环境变量名 = 模板 env_prefix + 字段名大写（见 backend/app/data/rag_integration_templates.json）
RAG_BACKEND=iflytek_chatdoc
IFLYTEK_CHATDOC_APP_ID=
IFLYTEK_CHATDOC_API_SECRET=
IFLYTEK_CHATDOC_WIKI_FILTER_SCORE=0.82
# true 表示切分完成后停在 splited，管理员批量调用 file/embedding；false 表示上传后自动向量化。
CHATDOC_STEP_BY_STEP=true
# ChatDoc 状态回调（须公网可达）：{PUBLIC_API_BASE_URL}{CHATDOC_WEBHOOK_PATH}
PUBLIC_API_BASE_URL=http://localhost:8001
CHATDOC_WEBHOOK_PATH=/api/v1/webhooks/chatdoc/status
CHATDOC_WEBHOOK_VERIFY_SIGNATURE=false

# RAG 低置信度拒答阈值（0–1），低于此分数且要求引用时不生成回答
RAG_RETRIEVAL_MIN_SCORE=0.65

RAG_RETRIEVAL_LIMIT=5
EMBEDDING_DIM=384

# 本地知识库：不提交模型权重；首次使用时从 Hugging Face 下载到本机缓存。
# Windows 可改为 D:/zhike-models/bge-small-zh-v1.5，Linux/macOS 使用本机可写目录。
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DIMENSION=512
LOCAL_EMBEDDING_CACHE_DIR=./storage/models
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_KNOWLEDGE_CHUNK_SIZE=1200
LOCAL_KNOWLEDGE_CHUNK_OVERLAP=150
LOCAL_KNOWLEDGE_SNIPPET_SIZE=800

# LoRA 推理服务（T-B-11）：本地 Qwen2.5-7B 微调模型，运行在 WSL2 中，端口 8002。
# LORA_INFERENCE_HOST 会被 register_lora_provider.py 自动读取。
# 不设置时脚本会尝试自动探测 WSL2 IP，失败则回退到 127.0.0.1。
# LORA_INFERENCE_HOST=172.27.195.47
# LORA_INFERENCE_PORT=8002

# 代码沙箱微服务（Node + Pyodide）。联调"代码执行"功能时需要单独启动，见 backend/SETUP.md 沙箱章节。
# FastAPI 后端转发到沙箱微服务的地址，默认 8003（不与 B-11 推理服务 8002 冲突）
SANDBOX_SERVICE_URL=http://127.0.0.1:8003
# 单次代码执行超时（秒），超时返回超时错误而非无限阻塞
SANDBOX_EXECUTION_TIMEOUT_SECONDS=10
# 代码体积上限（字节），防止超大负载压垮微服务
SANDBOX_MAX_CODE_BYTES=65536
# 沙箱接口限流：每用户每分钟最多执行次数
SANDBOX_RATE_LIMIT_PER_MINUTE=20
# 可选，仅本机优化：把 Pyodide 依赖放到其他盘符时指向自备的 node_modules 目录。
# 不设则使用沙箱服务本目录（backend/sandbox-service/node_modules）。
# SANDBOX_NODE_MODULES=D:/zhike-sandbox-deps/node_modules

